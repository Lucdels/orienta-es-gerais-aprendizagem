    <span style="font-size: 13px; color: #555;">Lembre-se de excluir funções de nível superior, técnico, gerência/confiança e temporários.</span></p>
    
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
        <input type="number" id="totalEmpregados" placeholder="Ex: 100" min="0" step="1" style="padding: 10px; font-size: 18px; width: 200px; border: 1px solid #aaa; border-radius: 4px;">
        <button onclick="calcularCota()" style="background-color: #003399; color: white; padding: 10px 35px; font-size: 18px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Calcular Cota</button>
    </div>

    <div id="resultadoCota" class="result-box" style="background-color: #f9f9fc; margin-top: 20px; padding: 15px 20px; border: 1px solid #ccc; border-radius: 6px;">
        <span style="color: #888;">Preencha o campo acima e clique em "Calcular Cota".</span>
    </div>

    <div id="disclaimerCota" class="disclaimer" style="background-color: #fff5e6; border-left: 6px solid #cc7a00; padding: 12px 18px; margin-top: 15px; font-size: 14px; color: #664400; border-radius: 4px; display: none;">
        <strong>⚠️ Importante:</strong> Esta calculadora é uma <strong>ferramenta de simulação</strong> para fins orientativos. O número exato de aprendizes a serem contratados deve ser verificado junto à <strong>Auditoria-Fiscal do Trabalho</strong>, considerando as exclusões legais específicas de cada estabelecimento.
    </div>
</div>

<script>
    function calcularCota() {
        var input = document.getElementById('totalEmpregados');
        var resultDiv = document.getElementById('resultadoCota');
        var disclaimerDiv = document.getElementById('disclaimerCota');
        var total = input.value.trim();

        if (total === "" || isNaN(total) || parseInt(total) < 0) {
            resultDiv.innerHTML = "<span style='color: #cc0000;'>❌ Por favor, insira um número válido de empregados (ex: 50).</span>";
            disclaimerDiv.style.display = 'none';
            return;
        }

        var num = parseInt(total);
        var min = Math.ceil(num * 0.05);
        var max = Math.ceil(num * 0.15);

        var outputHtml = "";
        if (num < 7) {
            outputHtml = "<strong>📌 Menos de 7 empregados:</strong> Sua empresa <strong>não é obrigada</strong> a contratar aprendizes por lei (cota facultativa).<br>" +
                         "Caso opte pela contratação voluntária, o limite máximo é de <strong>" + max + "</strong> aprendiz(is).";
        } else {
            outputHtml = "<strong>📊 Estimativa de cota para o estabelecimento:</strong><br>" +
                         "🔹 <strong>Mínimo:</strong> " + min + " aprendiz(is) (5%)<br>" +
                         "🔹 <strong>Máximo:</strong> " + max + " aprendiz(is) (15%)";
        }

        resultDiv.innerHTML = outputHtml;
        disclaimerDiv.style.display = 'block';
    }

    document.getElementById('totalEmpregados').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            calcularCota();
        }
    });
</script>

